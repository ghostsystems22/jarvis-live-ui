{
  "name": "Jarvis Operator Console",
  "short_name": "JARVIS",
  "description": "Private Jarvis operator console",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#020715",
  "theme_color": "#020715",
  "orientation": "portrait-primary",
  "icons": [
    { "src": "/icons/jarvis-192.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "/icons/jarvis-512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any maskable" }
  ]
}
